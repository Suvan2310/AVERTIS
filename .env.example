# =======================================================
# AVERTIS DISASTER INTELLIGENCE - ENVIRONMENT CONFIGURATION
# SIH 2026 Problem Statement: SIH26001
# =======================================================

# Core API & Database
DATABASE_URL=sqlite:///./avertis.db
VITE_API_URL=http://127.0.0.1:8000/api

# Risk Thresholds
THRESHOLD_LOW=25.0
THRESHOLD_MODERATE=50.0
THRESHOLD_HIGH=75.0

# -------------------------------------------------------
# SMS GATEWAY & OTP DELIVERY CONFIGURATION
# -------------------------------------------------------
# Toggle live SMS dispatch (true/false). When false, OTP is simulated in logs & responses.
SMS_ENABLED=false

# Provider Selection: FAST2SMS | MSG91 | TWILIO | SIMULATED
SMS_GATEWAY_PROVIDER=FAST2SMS

# SMS Provider API Key (e.g., Fast2SMS authorization key or MSG91 authkey)
SMS_API_KEY=your_fast2sms_or_msg91_api_key_here

# Fast2SMS Specific Settings:
# SMS_ROUTE: "otp" (direct OTP route) or "q" (Quick SMS route) or "dlt"
SMS_ROUTE=otp
SMS_SENDER_ID=AVERTS

# MSG91 Specific Settings:
# SMS_TEMPLATE_ID: DLT approved template ID for MSG91 OTP route
SMS_TEMPLATE_ID=your_msg91_template_id_here

# OTP Security Parameters
OTP_EXPIRY_SECONDS=300
ENABLE_DEMO_OTP_BYPASS=true
DEFAULT_DEMO_OTP=123456
